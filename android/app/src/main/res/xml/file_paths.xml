<?xml version="1.0" encoding="utf-8"?>
<!--
  Least privilege: only the app-private directory Capacitor's WebView uses for
  camera captures from <input type="file" capture> (BridgeWebChromeClient,
  getExternalFilesDir(Pictures)). No external-storage root, no cache root.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="captured_images" path="Pictures/" />
</paths>
