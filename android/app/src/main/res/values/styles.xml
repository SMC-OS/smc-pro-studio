<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: always light (the shell has no dark theme yet). -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/smc_native_surface</item>
    </style>

    <!--
      Theme after the launch screen. Light-only (not DayNight) with the native
      surface as the window background, so a device in dark mode never shows a
      black frame between the launch screen and the first WebView paint.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/smc_native_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      Launch screen (androidx core-splashscreen; Android 12+ system splash API
      and back-ported on older versions): calm surface + centred app mark.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/smc_native_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
