# STAGING client configuration (Phase M2): physical-device QA builds only.
# Used by `vite build --mode staging` (bun run build:staging / build:android:staging).
#
# Every value here is PUBLIC by design and ends up in the client bundle:
# the Supabase project URL and its *publishable* key (RLS + explicit grants
# protect the data, not this key). This file is committed so staging builds
# are reproducible and reviewable. It must never contain a secret, service-role
# key, database password or production value. tests/environment-config.test.mjs
# enforces an allow-list of keys and rejects secret-shaped values.
#
# Staging project: smc-pro-studio-staging (ref qezixxtknqbijnudvhal, eu-west-2),
# isolated staging-only data. Never point this file at production.
VITE_APP_ENV="staging"
VITE_SUPABASE_URL="https://qezixxtknqbijnudvhal.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_olxZJ4esZqiQlwX1UwKUYA_-_tw7uGl"

# Explicitly empty so a developer's .env.local (lower priority in Vite) can
# never leak local/dev values into a staging build. Native builds always use
# the smcprostudio:// auth redirects; there is no hosted staging web origin
# yet, so web redirects fall back to the page's own origin. The V1 social
# shell does not call the Express API.
VITE_APP_URL=""
VITE_API_BASE_URL=""
VITE_STRIPE_PUBLISHABLE_KEY=""
VITE_LEGACY_APP_OPT_IN="false"

# Social sign-in providers stay off until each is configured on staging and tested.
VITE_SUPABASE_OAUTH_GOOGLE_ENABLED="false"
VITE_SUPABASE_OAUTH_APPLE_ENABLED="false"
VITE_SUPABASE_OAUTH_FACEBOOK_ENABLED="false"
