# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_APP_URL: Public web origin used for email verification, recovery and OAuth redirects.
# Keep environment-specific; production must use an SMC-owned HTTPS domain.
VITE_APP_URL="http://127.0.0.1:5173"

# VITE_API_BASE_URL: Public HTTPS origin of the separately deployed API.
# Required for Capacitor iOS/Android builds. Do not include a trailing slash.
VITE_API_BASE_URL="https://api.example.com"

# ALLOWED_ORIGINS: Comma-separated web and Capacitor origins allowed to call the API.
ALLOWED_ORIGINS="https://app.example.com,capacitor://localhost,https://localhost"

# Supabase public configuration. Publishable keys are designed for public clients;
# all exposed tables still require correct RLS policies.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Provider buttons fail closed until each real SMC-owned provider is configured and tested.
VITE_SUPABASE_OAUTH_GOOGLE_ENABLED="false"
VITE_SUPABASE_OAUTH_APPLE_ENABLED="false"
VITE_SUPABASE_OAUTH_FACEBOOK_ENABLED="false"

# Phase 3 feature flag: renders the new Home/Discover/Create/Messages/Profile
# social shell instead of the existing App. Defaults to off (existing
# production experience) until explicitly enabled per environment.
VITE_SOCIAL_SHELL_ENABLED="false"

# Server-side Supabase authentication and role lookup.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Secret/service-role key: server-only. Never prefix with VITE_ or ship in a client bundle.
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"

# Demo integrations are available only outside production and only when explicitly enabled.
ENABLE_DEMO_FEATURES="false"

# STRIPE_SECRET_KEY: Required for live Stripe Payment Intent creation & checkout flows.
# Configure via AI Studio Secrets menu.
STRIPE_SECRET_KEY="sk_test_51..."

# VITE_STRIPE_PUBLISHABLE_KEY: Public key for client-side Stripe Elements.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_51..."
